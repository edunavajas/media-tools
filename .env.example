# Bearer token required by every endpoint except GET /health.
# If unset the service fails closed (500 on any protected route).
MEDIA_TOOLS_TOKEN=

# Nan Builders Whisper (OpenAI-compatible, required when TRANSCRIPTION_PROVIDER=nan)
NAN_BASE_URL=https://api.nan.builders/v1
NAN_API_KEY=
NAN_MODEL=whisper

# Transcription provider: nan (default) or groq
TRANSCRIPTION_PROVIDER=nan

# Groq official SDK settings (only when TRANSCRIPTION_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Transcription request timeout (seconds)
TIMEOUT_SECONDS=1800

# Persistent data dir (jobs.db + job outputs)
DATA_DIR=/data

# 1 -> upgrade yt-dlp (and yt-dlp-ejs) at container start (YouTube breaks often)
YTDLP_AUTOUPDATE=0

# Netscape cookies file exported from a logged-in YouTube session. Strongly
# recommended: without it YouTube serves the "Sign in to confirm you're not a
# bot" / "The page needs to be reloaded." walls from datacenter IPs.
YTDLP_COOKIES_FILE=

# Optional outbound proxy for yt-dlp (useful when YouTube blocks the host IP).
YTDLP_PROXY=

# JS runtime used to solve YouTube's n-sig / player challenges (deno is bundled
# in the image; see Dockerfile). Keep in sync with the available binary.
YTDLP_JS_RUNTIME=deno

# sync -> run jobs inline (tests only)
WORKER_MODE=async
